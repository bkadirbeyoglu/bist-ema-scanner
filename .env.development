# Development environment
TRADING_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading
REDIS_URL=redis://localhost:6379
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Trading settings
TRADING_MAX_POSITIONS=50
TRADING_MAX_ORDER_VALUE=100000

# Risk settings
TRADING_ENABLE_RISK_CHECKS=false

# Feature flags
TRADING_WEBSOCKET_ENABLED=true
TRADING_PAPER_TRADING=true