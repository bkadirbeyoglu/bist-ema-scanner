# Development environment
# ============================================
# Development Environment Configuration
# ============================================

# Application Environment
TRADING_ENV=development

# Development configuration
EVENT_BUS_TYPE=inmemory  # ← Add this line (fast, simple, local-only)
# Development with SQS (for testing distributed setup locally)
#EVENT_BUS_TYPE=sqs


# Database Configuration (Docker Compose uses service names)
DATABASE_URL=postgresql://trading:password@postgres:5432/trading_db
# Note: 'postgres' is the Docker Compose service name, not localhost
DB_NAME=trading_db
DB_USER=trading
DB_PASSWORD=password

# Redis Configuration (Docker Compose uses service names)
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Trading Settings
TRADING_MAX_POSITIONS=50
TRADING_MAX_ORDER_VALUE=100000

# Risk Settings
TRADING_ENABLE_RISK_CHECKS=false

# Feature Flags
TRADING_WEBSOCKET_ENABLED=true
TRADING_PAPER_TRADING=true

# AWS Configuration (LocalStack for development)
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# API Keys (loaded from main .env file)
# ALPHA_VANTAGE_API_KEY is set in .env