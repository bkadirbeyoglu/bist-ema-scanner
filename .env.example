# ============================================
# Trading System Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# API Keys
# ============================================
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Optional API keys
# TWELVEDATA_API_KEY=
# POLYGON_API_KEY=

# ============================================
# Environment Selection
# ============================================
ENVIRONMENT=development  # development, production, or test

# ============================================
# Database Configuration
# ============================================
DB_NAME=trading_db
DB_USER=trading
DB_PASSWORD=changeme_in_production

# ============================================
# AWS Configuration
# ============================================
# For LocalStack (development):
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# For Production AWS (override in .env.production):
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=your_real_aws_key
# AWS_SECRET_ACCESS_KEY=your_real_aws_secret
# AWS_DEFAULT_REGION=us-east-1

# ============================================
# Application Settings (optional overrides)
# ============================================
# These have defaults but can be overridden
# LOG_LEVEL=INFO
# TRADING_PAPER_TRADING=true