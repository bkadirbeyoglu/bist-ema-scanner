# ============================================
# Production Environment Configuration
# ============================================

# Application Environment
TRADING_ENV=production

EVENT_BUS_TYPE=sqs  # ← Add this line (distributed, persistent)

# Database Configuration (use environment-specific values)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}
DB_NAME=trading_db
DB_USER=trading
DB_PASSWORD=${DB_PASSWORD}  # Override this in production!

# Redis Configuration
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Trading Settings
TRADING_MAX_POSITIONS=100
TRADING_MAX_ORDER_VALUE=1000000

# Risk Settings
TRADING_ENABLE_RISK_CHECKS=true
TRADING_MAX_PORTFOLIO_EXPOSURE=0.3

# Feature Flags
TRADING_WEBSOCKET_ENABLED=true
TRADING_PAPER_TRADING=false

# AWS Configuration (Real AWS in production, not LocalStack)
# Override these in production deployment
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=us-east-1

# API Keys (use secrets management in production!)
ALPHA_VANTAGE_KEY=${ALPHA_VANTAGE_API_KEY}
POLYGON_KEY=${POLYGON_KEY}