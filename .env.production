# Production environment
TRADING_ENV=production
DATABASE_URL=postgresql://prod-user:${DB_PASSWORD}@prod-db:5432/trading
REDIS_URL=redis://prod-redis:6379
LOG_LEVEL=INFO
LOG_FORMAT=json

# Trading settings
TRADING_MAX_POSITIONS=100
TRADING_MAX_ORDER_VALUE=1000000

# Risk settings
TRADING_ENABLE_RISK_CHECKS=true
TRADING_MAX_PORTFOLIO_EXPOSURE=0.3

# API Keys (use secrets in production!)
ALPHA_VANTAGE_KEY=${ALPHA_VANTAGE_KEY}
POLYGON_KEY=${POLYGON_KEY}

# Feature flags
TRADING_WEBSOCKET_ENABLED=true
TRADING_PAPER_TRADING=false