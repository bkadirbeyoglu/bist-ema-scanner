# ============================================================
# .dockerignore - Exclude files from Docker build context
# ============================================================
# This file works like .gitignore but for Docker builds
# Reduces build context size = faster builds
# ============================================================

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Documentation
docs/
*.md
!README.md

# Environment files (contain secrets!)
.env
.env.*
*.env

# Docker files (not needed in build context)
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs and databases
*.log
*.sqlite
*.db

# Temporary files
tmp/
temp/